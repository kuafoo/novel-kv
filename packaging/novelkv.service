[Unit]
Description=NovelKV - High-performance text KV storage
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=novelkv
Group=novelkv

ExecStart=__BIN_PATH__ --config /etc/novelkv/novelkv.conf $NOVELKV_OPTS
EnvironmentFile=-/etc/novelkv/novelkv.env

WorkingDirectory=__DATA_DIR__

Restart=on-failure
RestartSec=5

LimitNOFILE=65535

ProtectSystem=strict
ReadWritePaths=__DATA_DIR__ /var/log/novelkv
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=novelkv

TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=process

[Install]
WantedBy=multi-user.target
